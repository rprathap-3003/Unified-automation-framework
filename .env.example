# ==============================================================================
# Environment Configuration & Secrets Template
# Copy this file to .env and fill in required secrets. Do NOT commit .env to git.
# ==============================================================================

# Active environment: dev | staging | prod
ENV=dev

# Web Automation Overrides
WEB_BROWSER=chrome
WEB_HEADLESS=false
WEB_BASE_URL=https://www.saucedemo.com
SELENIUM_GRID_URL=

# Mobile Automation (Appium)
APPIUM_SERVER_URL=http://127.0.0.1:4723
MOBILE_PLATFORM=android
ANDROID_DEVICE_NAME=emulator-5554
IOS_DEVICE_NAME=iPhone 15 Pro
ANDROID_APP_PATH=
IOS_APP_PATH=

# API Automation
API_BASE_URL=https://petstore.swagger.io/v2
API_KEY=special-key
API_TIMEOUT=30

# Desktop Automation (Windows)
DESKTOP_BACKEND=uia
WINAPPDRIVER_URL=http://127.0.0.1:4723

# Reporting
ALLURE_RESULTS_DIR=reports/allure-results
SCREENSHOT_ON_FAILURE=true
